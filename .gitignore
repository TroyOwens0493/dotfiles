# Only the reviewed source directories are tracked.
/*
!/.gitignore
!/install.sh
!/readme.md
!/shared/
!/macos/
!/omarchy/
!/scripts/
!/tests/

# Local machine overrides and generated/private state.
local/
local.conf
local.lua
.DS_Store
.env
.env.*
!.env.example
auth.json
credentials.json
trust.json
models-store.json
sessions/
/shared/pi/workflows/
node_modules
__pycache__/
*.log
*.tmp
*.swp
*.pem
*.key
*.backup.*
/shared/nvim/tmp/
/shared/shopify/logs/
/shared/tmux/plugins/

# Legacy sync paths on Macs with an in-place migration.
/omarchy/settings.json
/omarchy/sync.py
/omarchy/test_sync.py
*.bak.*
.dotfiles-package-lock
.zshrc.local
.bashrc.local
colors.local.sh
